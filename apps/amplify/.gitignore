# Ballerina build output and generated sources
target/
generated/

# Runtime config may hold secrets: commit Config.toml.local / tests/Config.toml only
Config.toml
!**/tests/Config.toml

# Local env files (keep the template)
local/.env
local/*.env
!local/.env.example

# Decrypted .gitsecret files
*.secret
!*.secret.example

.DS_Store

# Load-test scratch (dev JWTs), scripts/load-test.sh
local/.load/

# Dev JWT signing key and JWKS, generated by `local/dev-jwt/mint-dev-jwt.sh init`; the script stays tracked
local/dev-jwt/*
!local/dev-jwt/mint-dev-jwt.sh

# Local people-stub roster (real names and emails); copy directory.json.example to start
local/people-stub/directory.json
