# Local stack settings. `make env` copies this to local/.env and fills every empty secret below with a random
# value (openssl). Never commit local/.env. These are compose interpolation variables only: compose.yaml maps
# them onto the BAL_CONFIG_VAR_* names the components read (the same names Choreo and OpenChoreo use; table in
# README.md > Configuration).

# ---- Identity (ADR-022 / ADR-023) -----------------------------------------------------------------------
# Default profile (no gateway): accept tokens from local/dev-jwt/mint-dev-jwt.sh. Refused unless
# environment=local, which compose hard-codes for amplify-api.
AMPLIFY_DEV_LOCAL_JWT=true
# APIM profile only (pending the non-prod Asgardeo org, D10): the gateway's backend JWT trust.
GATEWAY_JWKS_URL=
GATEWAY_ISSUER=
GATEWAY_AUDIENCES=amplify-local
# Non-prod Asgardeo org (D10 / ADR-008), for the APIM key manager and a local One WSO2. Not used yet.
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<non-prod-org>
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=

# ---- PostgreSQL 18 (one user per component, M3) ----------------------------------------------------------
# POSTGRES_PASSWORD is the bootstrap admin the migrate runner connects as; it sets the app role passwords.
POSTGRES_PASSWORD=
AMPLIFY_API_DB_PASSWORD=
AMPLIFY_JOBS_DB_PASSWORD=
AMPLIFY_READONLY_DB_PASSWORD=



# ---- Token encryption (AES-256-GCM, base64 32-byte key; make env runs `openssl rand -base64 32`) --------
TOKEN_ENCRYPTION_KEY_ID=local-1
TOKEN_ENCRYPTION_KEY=

AMPLIFY_SHARE_PAGE_BASE_URL=

# ---- Where a share announcement goes (feat/amplify_on_novera) ----------------------------------------------
# AMPLIFY_ON_NOVERA: send the announcement through Novera, which DMs everyone who added it. Default true. Also
# needs the NOVERA_* values below; without them Novera counts as not configured.
# AMPLIFY_ON_WEBHOOK: post the Club card through the Google Chat webhook above. Default false. `make e2e` reads
# the chat-stub, so it needs true here.
# Both on: Novera decides retry and failure, the webhook card is best effort (never posted twice). Both off, or
# a channel on without its settings: announcements wait (deferred) until one is ready.
AMPLIFY_ON_NOVERA=true
# Novera's POST /internal/notifications (its Choreo gateway URL, https) and the application subscribed to its
# API. Local stack has no Novera stub. Set the secret by hand in local/.env; never commit it.
##NOVERA_NOTIFY_URL=http://host.docker.internal:3003/internal/notifications
##NOVERA_TOKEN_URL=http://host.docker.internal:3003/token
#NOVERA_CLIENT_ID=mock
#NOVERA_CLIENT_SECRET=mock
#NOVERA_ALLOW_INSECURE_HTTP=true
NOVERA_NOTIFY_URL=# must be https
NOVERA_TOKEN_URL=
NOVERA_CLIENT_ID=
NOVERA_CLIENT_SECRET=
NOVERA_SCOPES=
NOVERA_BUTTON_URL=
NOVERA_ALLOW_INSECURE_HTTP=true

# ---- Scheduler (ADR-026) -----------------------------------------------------------------------------------
SCHEDULER_DB_PASSWORD=
# Shortest run.schedule amplify-api accepts. 60 in every real environment; make e2e uses 10 to see a Run fast.
AMPLIFY_MIN_RUN_INTERVAL_SECONDS=10

WSO2_ORGANIZATION_URN=

# Dev mode: true = mock-linkedin, false = real LinkedIn (needs the REAL vars). See scripts/compose.sh.
# ---- LinkedIn (mock-linkedin locally) ---------------------------------------------------------------------
# Made-up client credentials shared by amplify-api and the mock. Real non-prod app values never go here.
LINKEDIN_CLIENT_ID=amplify-local
LINKEDIN_CLIENT_SECRET=837b18c22433c6d9f5a758fa7dee98ae
# The One WSO2 callback page (a local One WSO2 on :3000); the mock only redirects there.
#LINKEDIN_REDIRECT_URI=http://localhost:3000/amplify/connect/callback
# Server-side bases (service names) and the browser-facing authorization base (published port).
#LINKEDIN_API_BASE_URL=http://mock-linkedin:9090
#LINKEDIN_OAUTH_BASE_URL=http://mock-linkedin:9091
#LINKEDIN_AUTHORIZE_BASE_URL=http://localhost:19091
#LINKEDIN_USE_MOCK=true

# LinkedIn Integration Testing 
# ---- LinkedIn (Scott Dev App: Learnwmembersocial for ACME-API-LEARN org) ---------------------------------------------------------------------
LINKEDIN_REDIRECT_URI=http://localhost:3000/amplify/connect/callback
# Server-side bases (service names) and the browser-facing authorization base (published port).
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_OAUTH_BASE_URL=https://www.linkedin.com
#empty on purpose
LINKEDIN_AUTHORIZE_BASE_URL=
#LINKEDIN_CLIENT_ID=
#LINKEDIN_CLIENT_SECRET=
LINKEDIN_REAL_CLIENT_ID=
LINKEDIN_REAL_CLIENT_SECRET=
LINKEDIN_USE_MOCK=true

# Employee count cache and the scorecard lines (ADR-036). Unset = these defaults.
HEADCOUNT_CACHE_SECONDS=604800
SCORECARD_TARGET_CONNECTED_PCT=25
SCORECARD_MAX_EXPIRED_PCT=5
SCORECARD_TARGET_SHARE_SUCCESS_PCT=98
SCORECARD_TARGET_PRIORITY_REACH_PCT=25
SCORECARD_TARGET_ACTIVE_30D=100
SCORECARD_TARGET_REPOSTS_PER_MONTH=600

# Access (ADR-038): Asgardeo groups per capability, comma separated; any one group grants it.
# Unset = these defaults. Add a group here to try it locally, e.g. a second campaign team.
AMPLIFY_CAN_CAMPAIGN_GROUPS=amplify_po,amplify_marketing
AMPLIFY_CAN_DASHBOARD_GROUPS=amplify_po,amplify_marketing,amplify_slt,amplify_admin
AMPLIFY_CAN_EXPORT_GROUPS=amplify_po,amplify_marketing,amplify_slt,amplify_admin
AMPLIFY_CAN_REVIEW_SHARES_GROUPS=amplify_po
AMPLIFY_CAN_POINT_RULES_GROUPS=amplify_po
AMPLIFY_CAN_ADJUST_POINTS_GROUPS=amplify_po
AMPLIFY_CAN_PO_DASHBOARD_GROUPS=amplify_po
AMPLIFY_CAN_REPORTS_GROUPS=amplify_slt,amplify_po
AMPLIFY_CAN_ADMIN_GROUPS=amplify_admin
AMPLIFY_DB_PASSWORD=
AMPLIFY_INTERNAL_API_KEY=
AMPLIFY_SCHEDULER_API_KEY=
MOCK_ADMIN_KEY=

# Link in the LinkedIn consent dialog (sent to One WSO2 in GET /me)
PRIVACY_NOTICE_URL=https://wso2.com/privacy-policy

# HR Entity GraphQL
HR_ENTITY_URL=
HR_ENTITY_TOKEN_URL=
HR_ENTITY_CLIENT_ID=
HR_ENTITY_CLIENT_SECRET=


#########################
# Local (the Compose stack): add these four lines to local/.env, which is gitignored:
# HR_ENTITY_URL=<the GraphQL endpoint>
# HR_ENTITY_TOKEN_URL=<OAuth2 token URL>
# HR_ENTITY_CLIENT_ID=<client id>
# HR_ENTITY_CLIENT_SECRET=<client secret>
# compose.yaml passes them to both amplify-api and amplify-jobs. If HR_ENTITY_URL is empty it defaults to people-stub, so the URL has to be set to hit the real service. local/.env.example doesn't list these yet. I can add commented placeholders if you want.
# 
# Choreo (dev, staging, prod): set the same four on each of the two components:
#
# ┌──────────────────────────────────┬─────────────────────────────────────────────────────┬─────────────────────────────┐
# │            Component             │                    Config names                     │       Where it lives        │
# ├──────────────────────────────────┼─────────────────────────────────────────────────────┼─────────────────────────────┤
# │ Amplify Backend (amplify-api)    │ HRENTITYBASEURL, HRENTITYTOKENURL, HRENTITYCLIENTID │ Config values               │
# ├──────────────────────────────────┼─────────────────────────────────────────────────────┼─────────────────────────────┤
# │                                  │ HRENTITYCLIENTSECRET                                │ Secret amplify-api-secrets  │
# ├──────────────────────────────────┼─────────────────────────────────────────────────────┼─────────────────────────────┤
# │ Jobs (amplify-jobs)              │ HRENTITYBASEURL, HRENTITYTOKENURL, HRENTITYCLIENTID │ Config values               │
# ├──────────────────────────────────┼─────────────────────────────────────────────────────┼─────────────────────────────┤
# │                                  │ HRENTITYCLIENTSECRET                                │ Secret amplify-jobs-secrets │
# └──────────────────────────────────┴─────────────────────────────────────────────────────┴─────────────────────────────┘
# 
# The secret key in each is BAL_CONFIG_VAR_HRENTITYCLIENTSECRET, as workload.yaml wires it. Jobs needs them for the leaver sweep, but the sweep is OFF by default. 
# If you leave Jobs empty, nothing breaks until you switch the sweep on. Redeploy both after setting them.
# Check first: the entity's employees filter and field names are copied from leave-app, so if My Team answers UNAVAILABLE after this, look for People directory answered with GraphQL errors in the api log.
#########################
