# Local configuration for the mock LinkedIn server.
# Copy to Config.toml and change the values. Config.toml is git-ignored.

# Interface to bind. Use "0.0.0.0" in a container.
listenerHost = "localhost"

apiPort = 9090
wwwPort = 9091

# Base URL the mock uses when it hands out image upload URLs.
wwwBaseUrl = "http://localhost:9091"

# The OAuth client your app is configured with. Made-up values only.
clientId = "<mock-client-id>"
clientSecret = "<mock-client-secret>"
redirectUris = ["http://localhost:3000/auth/linkedin/callback"]

# Exposes GET /mock/posts and POST /mock/reset on the API port. Local use only.
enableMockAdmin = true

# Key those endpoints require, sent as X-Amplify-Internal-Key. At least 32 characters, and required
# whenever enableMockAdmin is true: without it the endpoints are not attached at all. Made-up value.
mockAdminKey = "<local-only-admin-key-at-least-32-chars>"

# Largest image body PUT /dms-uploads accepts, in bytes.
# maxUploadBytes = 10485760

# memberDailyLimit = 150
# appDailyLimit = 100000

# [member]
# sub = "782bbtaQ"
# givenName = "Avery"
# familyName = "Mock"
# email = "avery.mock@example.com"
# picture = "https://media.licdn.com/dms/image/mock/profile-displayphoto.jpg"
# locale = "en_US"
