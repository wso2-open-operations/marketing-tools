      "name": "Auth and Basics",
      "item": [
        {
          "name": "Fetch the Authenticated User's Ad Accounts",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Restli-Protocol-Version",
                "value": "2.0.0",
                "type": "text"
              },
              {
                "key": "LinkedIn-Version",
                "value": "{{insert_version}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "{{insert_token}}",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/adAccountUsers?q=authenticatedUser",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "adAccountUsers"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "authenticatedUser"
                }
              ]
            }
          },
          "response": []
        },
