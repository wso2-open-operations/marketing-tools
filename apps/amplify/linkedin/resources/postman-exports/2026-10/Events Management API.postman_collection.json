            "url": {
              "raw": "{{baseUrl}}/events?q=eventsByOrganizer&organizer=urn%3Ali%3Aorganization%3A7185861&start=0&count=10&excludeCancelled=true&timeBasedFilter=(lifeCycleState%3APAST)&entryCriteria=PUBLIC&sortOrder=END_TIME_DESC\n",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "eventsByOrganizer"
                },
                {
                  "key": "organizer",
                  "value": "urn%3Ali%3Aorganization%3A7185861"
                },
                {
                  "key": "start",
                  "value": "0"
                },
                {
                  "key": "count",
                  "value": "10"
                },
                {
                  "key": "excludeCancelled",
                  "value": "true"
                },
                {
                  "key": "timeBasedFilter",
                  "value": "(lifeCycleState%3APAST)"
                },
                {
                  "key": "entryCriteria",
                  "value": "PUBLIC"
                },
                {
                  "key": "sortOrder",
                  "value": "END_TIME_DESC\n"
                }
              ]
            }
