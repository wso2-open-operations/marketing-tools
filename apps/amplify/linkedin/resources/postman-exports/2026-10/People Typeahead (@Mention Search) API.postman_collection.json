    "name": "People Typeahead (@Mention Search) API",
    "description": "Standalone collection for the LinkedIn People Typeahead API (@mention search), used to discover organization page followers who can be @mentioned in UGC/organization posts. Restricted endpoint — permission is granted to select developers only. See https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-atmention-search-api\n\nUse together with the existing **community-management-env-versioning** environment (shared with the Community Management collection).\n\n--All requests are in the Restli 2.0 format--",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "17301545",
    "_collection_link": "https://go.postman.co/collection/45034303-8e6b554e-a4ce-4d09-bc42-190ea03205f3?source=collection_link"
  },
  "item": [
    {
      "name": "Search by Keyword for Organization Pages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{insert_token}}",
            "type": "text",
            "disabled": true
          },
          {
            "key": "LinkedIn-Version",
            "value": "{{insert_version}}",
            "type": "text"
          },
          {
            "key": "X-Restli-Protocol-Version",
            "value": "2.0.0",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/peopleTypeahead?q=organizationFollowers&keywords=surendra&organization=urn%3Ali%3Aorganization%3A{{organization_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "peopleTypeahead"
          ],
          "query": [
            {
              "key": "q",
              "value": "organizationFollowers"
            },
            {
              "key": "keywords",
              "value": "surendra"
            },
            {
              "key": "organization",
              "value": "urn%3Ali%3Aorganization%3A{{organization_id}}"
            }
          ]
        },
        "description": "Search followers of an organization page by keyword (matches first few characters of first/last name) so they can be @mentioned in a post. Returns up to 10 profiles: member urn, firstName, lastName, headline, optional photo."
      },
      "response": []
    },
