# --- Database (Postgres) ---
# Shared with the agenda-organizer Go service — same DB, same marketingops schema.
DB_HOST=localhost
DB_PORT=5432
DB_USER=<db-user>
# Leave blank for local trust-auth setups (e.g. default Postgres.app on macOS).
DB_PASSWORD=<db-password>
DB_NAME=<db-name>
DB_SCHEMA=marketingops
# Use "require" (or stricter) outside local development.
DB_SSLMODE=disable

# --- App server ---
PORT=8080
LOG_LEVEL=info
APP_ENV=development
# Base64-encoded 32-byte key used to encrypt PII at rest. Generate one with:
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# --- Auth (x-jwt-assertion) ---
# Set to true in production to enable JWT signature verification via JWKS.
# When false (local dev), the x-jwt-assertion token is decoded without signature verification.
TOKEN_VALIDATOR_ENABLED=false
JWKS_ENDPOINT=<https://<your-idp-host>/oauth2/jwks>
JWT_ISSUER=<https://<your-idp-host>/oauth2/token>
# Only required when TOKEN_VALIDATOR_ENABLED=true.
JWT_AUDIENCE=<expected-jwt-audience>
# Comma-separated list of JWT `groups` values allowed admin access. Currently
# gates POST /users/notifications (the broadcast push). Leaving this empty
# denies every caller rather than allowing every caller.
RBAC_ADMIN_ROLES=<comma-separated-admin-role-names>

# --- WSO2 Coin / O2C feature flags ---
EXCLUDE_EMPLOYEE_COIN_ALLOCATION=true
ENABLE_QR_VALIDATIONS=true
SESSION_END_TIME_OFFSET_MINUTES=15
# Minutes represented by one slot_index unit in marketingops.sessions. No
# authoritative constant exists in the schema; 5 matches all current data.
SESSION_SLOT_MINUTES=5

# FALLBACK venue timezone. The source of truth is now the real
# conference_config.timezone column (added upstream); the API reads it
# per-event to anchor session instants and to fill the `timezone` payload
# field. VENUE_TIMEZONE is used only when a config row's timezone column is
# empty (it is NOT NULL upstream, so this is a defensive default). Defaults to
# UTC if unset.
VENUE_TIMEZONE=Asia/Colombo

# --- External service integrations ---
# Each service authenticates via its own OAuth2 client-credentials grant.
# The QR scan flow (POST /qr/scan) cannot resolve real QR codes/wallets until
# these are filled in with real values from your environment.

# QR Portal — resolves a scanned QR code's metadata (event type, coin value, etc.)
QR_PORTAL_ENDPOINT=<https://<qr-portal-host>/qr-portal-backend/v1.0>
QR_PORTAL_TOKEN_URL=<https://<idp-host>/oauth2/token>
QR_PORTAL_CLIENT_ID=<qr-portal-oauth2-client-id>
QR_PORTAL_CLIENT_SECRET=<qr-portal-oauth2-client-secret>

# Wallet — resolves a user's primary wallet address
WALLET_ENDPOINT=<https://<wallet-service-host>/wallet-service/v1.0>
WALLET_TOKEN_URL=<https://<idp-host>/oauth2/token>
WALLET_CLIENT_ID=<wallet-oauth2-client-id>
WALLET_CLIENT_SECRET=<wallet-oauth2-client-secret>

# Transaction/Blockchain — reads wallet balances (GET /wallets/balances/me) and
# verifies shop payments (POST /shops/checkout/confirm). Also executes token
# transfers, though that remains unwired from the scan flow (see
# internal/service/coin_service.go).
TRANSACTION_ENDPOINT=<https://<transaction-service-host>/transaction-service/v1.0>
TRANSACTION_TOKEN_URL=<https://<idp-host>/oauth2/token>
TRANSACTION_CLIENT_ID=<transaction-oauth2-client-id>
TRANSACTION_CLIENT_SECRET=<transaction-oauth2-client-secret>

# Notification — delivers the admin broadcast push (POST /users/notifications).
# This backend never talks to FCM itself; it hands the recipient list to this
# service. Unlike the integrations above, its IdP client needs explicit scopes.
NOTIFICATION_ENDPOINT=<https://<notification-service-host>/notification-service/v1.0>
NOTIFICATION_TOKEN_URL=<https://<idp-host>/oauth2/token>
NOTIFICATION_CLIENT_ID=<notification-oauth2-client-id>
NOTIFICATION_CLIENT_SECRET=<notification-oauth2-client-secret>
NOTIFICATION_SCOPES=openid,email,groups,profile

# --- Shop ---
# The merchant wallet every shop payment must be sent to. POST
# /shops/checkout/confirm compares the on-chain transfer's decoded recipient
# against this, which is what stops a caller settling an order by pointing at an
# unrelated transfer.
#
# Leave it unset and confirm refuses every request rather than skipping the
# check: a deployment that forgot this must not hand out merchandise for free.
# The server still starts, so a deployment with no shop needs nothing here.
#
# Must match the frontend's `merchantWalletAddress` app-config row -- the client
# sends the attendee's payment to that address, and this verifies against this
# one. If the two disagree, every checkout is paid and then rejected.
SHOP_MASTER_WALLET_ADDRESS=<merchant-wallet-address>

# --- AI Features ---
# Unlike the services above, this authenticates by forwarding the caller's
# own x-jwt-assertion verbatim -- no OAuth2 client credentials of its own.
#
# One consolidated service backs matchmaking, personalize, picked-for-you and
# chat alike: it serves all of their paths off this root with no path prefix,
# so this single URL configures every AI call.
AI_SERVICE_URL=<https://<ai-service-host>>
AI_REQUEST_TIMEOUT_SECONDS=120
# Each defaults to false ("everything disabled") if unset.
AI_ENABLED_CHAT_ASSISTANT=false
AI_ENABLED_PERSONALIZED_AGENDA=false
AI_ENABLED_MATCH_MAKER=false
AI_ENABLED_O2_BAR=false

# --- API usage analytics (Moesif) ---
# One event per served request, so product questions ("is the AI agenda used?",
# "did anyone open the shop after day one?") can be answered from the API tier.
# The attendee microapp ships no client-side analytics SDK, which is why these
# questions have to be answered here.
#
# Off by default. Turning it on without an application id is a startup error,
# not a silent no-op: analytics that is enabled and throwing every event away
# looks exactly like a conference nobody attended.
MOESIF_ENABLED=false
# Moesif Collector Application Id (Moesif console -> API keys). Required when
# MOESIF_ENABLED=true.
MOESIF_APPLICATION_ID=<moesif-collector-application-id>
# Collector base URL. Leave unset for the global collector
# (https://api.moesif.net); set it to https://api-eu.moesif.net for the EU
# collector, or to a local stub when testing. Must be https:// -- every batch
# carries the application id in a header, so plaintext leaks a credential. The
# only exception is a loopback stub (http://localhost, http://127.0.0.1).
MOESIF_API_ENDPOINT=
# Stamped into every event's metadata alongside APP_ENV. MOESIF_PROJECT_NAME
# matches what the Ballerina conference service already reports, so both
# services' events sit in one comparable project; MOESIF_APP_NAME differs from
# it deliberately so they can still be told apart.
MOESIF_PROJECT_NAME=marketing-web
MOESIF_APP_NAME=con-app-backend
#
# What is and is not sent, since this is a third-party service:
#   - No request or response bodies, ever. The payloads here are attendee PII
#     (names, emails, companies, LinkedIn URLs) and free-text AI prompts.
#   - Headers are allow-listed to Content-Type, User-Agent and Accept-Language.
#     x-jwt-assertion, Authorization and Cookie are never forwarded.
#   - Query values are redacted unless allow-listed, so ?email= and ?q= keep
#     their key and lose their value.
#   - user_id is the attendee's UUID (the JWT sub), never their email address.
#   - Client IP is sent, for Moesif's geography and device breakdowns.
#
# Endpoints deliberately not tracked, because they are timers rather than
# features: GET /qr/history and GET /qr/summary (the microapp polls both every
# 5s), GET /shops/items and GET /wallets/balances/me (every 15s while the Shop
# tab is open), GET /app-configs (the freshness-beacon poll), and GET /health.
# See internal/analytics/routes.go for the full reasoning and for the
# feature/class labels each tracked route carries.
